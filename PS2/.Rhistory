# Gini
Gini_5 = abs(Gini(CNLSY79$ste_ppvt_totstd5))
Gini_10 = abs(Gini(CNLSY79$ste_ppvt_totstd10))
Gini_15 = abs(Gini(CNLSY79$ste_ppvt_totstd15))
# Theil
Theil_5 = Theil(abs(CNLSY79$ste_ppvt_totstd5))
Theil_10 = Theil(abs(CNLSY79$ste_ppvt_totstd10))
Theil_15 = Theil(abs(CNLSY79$ste_ppvt_totstd15))
# create dataframe for easy comparison
age = c("age_5", "age_10", "age_15")
gini = c(Gini_5, Gini_10, Gini_15)
theil = c(Theil_5, Theil_10, Theil_15)
gini_v_theil <- data.frame(age, gini, theil)
gini_v_theil
CNLSY79 <- CNLSY79 |>
mutate(
mothers_schooling_level = case_when( ysch_mom < 12 ~ "1",
ysch_mom == 12 ~ "2",
ysch_mom == 13 ~ "2",
ysch_mom == 14 ~ "2",
ysch_mom == 15 ~ "2",
ysch_mom >= 16 ~ "3",
))
CNLSY79 |>
group_by(mothers_schooling_level) |>
summarise(count = n())
# Income and group variable
#theil_decomp <- data.frame(ste_ppvt_totstd5, mothers_schooling_level)
# Fix zeros
CNLSY79$ste_ppvt_totstd5[CNLSY79$ste_ppvt_totstd5 <= 0] <- 1e-6
# Remove NA incomes
CNLSY79 <- CNLSY79[!is.na(CNLSY79$ste_ppvt_totstd5), ]
# Convert NA groups
CNLSY79$mothers_schooling_level <- ifelse(is.na(CNLSY79$mothers_schooling_level), "Unknown", CNLSY79$mothers_schooling_level)
# Overall mean
mu_total <- mean(CNLSY79$ste_ppvt_totstd5)
# Group means
mu_group <- tapply(CNLSY79$ste_ppvt_totstd5, CNLSY79$mothers_schooling_level, mean)
# Income shares s_k
s_group <- tapply(CNLSY79$ste_ppvt_totstd5, CNLSY79$mothers_schooling_level, sum) / sum(CNLSY79$ste_ppvt_totstd5)
# Theil T within each group
T_group <- tapply(CNLSY79$ste_ppvt_totstd5, CNLSY79$mothers_schooling_level, function(x) entropy(x))
# Within-group component
within <- sum(s_group * T_group)
# Between-group component
between <- sum(s_group * log(mu_group / mu_total))
# Total from decomposition
total_decomp <- within + between
# Total computed directly
total_direct <- entropy(CNLSY79$ste_ppvt_totstd5)
list(
total_direct   = total_direct,
total_decomp   = total_decomp,
within         = within,
between        = between,
share_within   = within / total_decomp,
share_between  = between / total_decomp
)
# Income and group variable
#theil_decomp <- data.frame(ste_ppvt_totstd5, mothers_schooling_level)
# Fix zeros
CNLSY79$ste_ppvt_totstd15[CNLSY79$ste_ppvt_totstd15 <= 0] <- 1e-6
# Remove NA incomes
CNLSY79 <- CNLSY79[!is.na(CNLSY79$ste_ppvt_totstd15), ]
# Convert NA groups
CNLSY79$mothers_schooling_level <- ifelse(is.na(CNLSY79$mothers_schooling_level), "Unknown", CNLSY79$mothers_schooling_level)
# Overall mean
mu_total <- mean(CNLSY79$ste_ppvt_totstd15)
# Group means
mu_group <- tapply(CNLSY79$ste_ppvt_totstd15, CNLSY79$mothers_schooling_level, mean)
# Income shares s_k
s_group <- tapply(CNLSY79$ste_ppvt_totstd15, CNLSY79$mothers_schooling_level, sum) / sum(CNLSY79$ste_ppvt_totstd15)
# Theil T within each group
T_group <- tapply(CNLSY79$ste_ppvt_totstd15, CNLSY79$mothers_schooling_level, function(x) entropy(x))
# Within-group component
within <- sum(s_group * T_group)
# Between-group component
between <- sum(s_group * log(mu_group / mu_total))
# Total from decomposition
total_decomp <- within + between
# Total computed directly
total_direct <- entropy(CNLSY79$ste_ppvt_totstd15)
list(
total_direct   = total_direct,
total_decomp   = total_decomp,
within         = within,
between        = between,
share_within   = within / total_decomp,
share_between  = between / total_decomp
)
options(scipen = 999)
